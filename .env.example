# ====================================================================
# USA AI CALLER v5.0 — FUNNEL EDITION
# ====================================================================

# 1. TWILIO (real calls + SMS to leads)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18005551234
MACHINE_DETECTION=false
CALL_TIMEOUT_SECONDS=30

# 2. LIVE PHONE VOICE — pick a path with VOICE_PATH:
#   auto   = OpenAI Realtime if OPENAI_API_KEY is set, else falls back to hybrid
#   hybrid = Groq Whisper (STT) + Groq Chat (LLM) + Multi-Engine TTS (ElevenLabs → Deepgram → Google TTS)
#            to the Twilio Media Stream today (see lib/hybrid-voice.js). No
#            OpenAI key required for this path.
#   openai = OpenAI Realtime only (lower latency, needs OPENAI_API_KEY)
VOICE_PATH=auto
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-10-01
OPENAI_VOICE=shimmer
LLM_PROVIDER=openai

# Hybrid engine (Groq + Multi-Engine TTS) — required if VOICE_PATH=hybrid or auto
# falls back here because OPENAI_API_KEY is empty.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# Multi-Engine TTS Cascade Fallbacks (auto-failover)
DEEPGRAM_API_KEY=
GOOGLE_TTS_API_KEY=
TTS_PRIMARY=elevenlabs

# 3. SERVER
PORT=5050
# Hostname only — no https://  (use ngrok host in prod tests)
PUBLIC_HOSTNAME=your-ngrok-url.ngrok-free.app
# REQUIRED in production — protects /api/* control endpoints
API_KEY=change-me-long-random-string
# Rate limit for call/SMS APIs (per IP / minute)
RATE_LIMIT_MAX=10
# Twilio webhook signature: soft-check by default; set true in production
# REQUIRE_TWILIO_SIGNATURE=true
# VALIDATE_TWILIO_SIGNATURE=false
# Hang up when answering machine detected (needs MACHINE_DETECTION=true)
HANGUP_ON_MACHINE=true
# Dangerous: auto-fire SMS from keyword planner (keep false — use AI emit codes)
PLANNER_AUTO_TOOLS=false

# 4. FUNNEL LINKS
DEFAULT_DEMO_URL=https://sass-ashen.vercel.app/
# Stripe Payment Link / Wise / Razorpay page
PAYMENT_URL=https://buy.stripe.com/your_payment_link
INVOICE_URL=https://buy.stripe.com/your_payment_link
DEFAULT_PACKAGE=starter
# Optional per-package overrides:
# PAYMENT_URL_STARTER=
# PAYMENT_URL_PRO=
# PAYMENT_URL_FULL=

WHATSAPP_URL=https://wa.me/919226484924
AGENT_NAME=Sarah
COMPANY_NAME=ZeroRefer Studio

# 5. AUTO "WHATSAPP EVENT" TO YOU (owner)
# A) SMS alert to your phone when lead gets demo/payment SMS
OWNER_NOTIFY_PHONE=+91XXXXXXXXXX
# B) Webhook (Zapier/Make/n8n) → push to your WhatsApp automatically
# OWNER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxx
